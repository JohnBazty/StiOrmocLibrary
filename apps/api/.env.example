PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Prefer Supabase Postgres when set (postgresql://…). When unset, the API builds from SUPABASE_* below or uses MySQL.
# On IPv4-only networks use Session pooler (port 5432), not direct db.* (often IPv6-only):
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Or omit DATABASE_URL and set these (API builds the pooler URI when SUPABASE_REGION is set):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_REGION=ap-northeast-2
# DB_PASS=your_database_password
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=

# Optional MySQL rollback / offline (used only when DATABASE_URL / Supabase pair is empty):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sti_library_app
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=sti_ormoc_library
DB_CONNECTION_LIMIT=10

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters_before_deployment

# Use a different random value from SESSION_SECRET.
JWT_SECRET=replace_with_a_second_32_character_random_secret
JWT_ISSUER=sti-ormoc-smart-library-api
JWT_AUDIENCE=sti-ormoc-smart-library-web
JWT_EXPIRES_IN_SECONDS=900

# Generate a third independent secret. It signs CSV exports so later edits are detectable.
REPORT_INTEGRITY_SECRET=replace_with_a_third_32_character_random_secret

# Keep this independent value stable. Changing it invalidates downloaded attendance passes.
ATTENDANCE_QR_SECRET=replace_with_a_fourth_32_character_random_secret

# Phase 2 scheduled-run endpoint. Use a unique 32+ character value; store the matching
# secret in Supabase Vault only when the new API and migrations have been deployed.
JOB_RUNNER_SECRET=

# Phase 6 school-email verification. Configure an institution-approved Microsoft 365
# application with Mail.Send restricted to one approved sender mailbox.
# These values are server-only. Do not put them in apps/web or browser variables.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# Personal Gmail prototype sender. Use a Google 16-character app password,
# never the normal Gmail password. Sends to each registrant's School Email.
# Gmail may block server-side mail; production use requires an explicit opt-in.
# Store the same server-only values in the hosted API environment if testing
# after deployment; leave GMAIL_ALLOW_PRODUCTION=false until that decision.
GMAIL_SENDER_EMAIL=sticollegeormoclibrarysystem@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_ALLOW_PRODUCTION=false

# Local, single-recipient Outlook verification test without a school Microsoft
# app registration. Sign up to Resend with the same recipient email. Its
# onboarding@resend.dev sender must never be used in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=

# Keep disabled until school finance approves issuer data, format, serials, and classifications.
INVOICE_ISSUANCE_ENABLED=false

ISBN_LOOKUP_TIMEOUT_MS=3500
# Optional. Google Books can serve light unauthenticated lookup traffic.
GOOGLE_BOOKS_API_KEY=

# Optional private Gotenberg/LibreOffice service for automatic DOCX page counting.
# The API converts DOCX to PDF, quotes its actual pages, and stores that same PDF for printing.
# Keep this service private and install the fonts used by students' documents on its image.
# On Vercel, use HTTPS and configure both values as server-only environment variables.
DOCX_RENDERER_URL=
DOCX_RENDERER_TOKEN=
